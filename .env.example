DATABASE_URL=postgresql://user:password@host:port/database
# Use a direct, non-pooled connection for migrations when your provider offers one.
MIGRATION_DATABASE_URL=postgresql://user:password@direct-host:port/database
# Per-function pool size (1-100). Defaults to 40; PgDog multiplexes these.
DATABASE_MAX_CONNECTIONS=40
# Set to true only for a separate preview database.
MIGRATE_PREVIEW_DATABASE=false

NEXTAUTH_SECRET=your-secret-key-here
NEXTAUTH_URL=http://localhost:3000
# Comma-separated origins allowed to access the local Next.js dev server.
NEXT_ALLOWED_DEV_ORIGINS=

HACKCLUB_CLIENT_ID=your-client-id
HACKCLUB_CLIENT_SECRET=beans

S3_ENDPOINT="https://s3.beans.beans"
S3_REGION="us-east-1"
S3_ACCESS_KEY_ID="beans-access-key"
S3_SECRET_ACCESS_KEY="beans-secret-key"
S3_BUCKET_NAME="beans-photos"
S3_PUBLIC_URL="https://s3.beans.beans/beans-photos"
# Optional S3 and image-processing tuning.
S3_FORCE_PATH_STYLE=true
S3_MAX_SOCKETS=100
SHARP_TIMEOUT_SECONDS=30

# Vercel creates these when Flags are enabled for the project.
FLAGS=
FLAGS_SECRET=

CRON_SECRET=generate-a-long-random-secret

# Slack app integration. Use slack-app-manifest.yaml to create/update the app.
SLACK_BOT_TOKEN=xoxb-your-slack-bot-token
SLACK_SIGNING_SECRET=your-slack-signing-secret
SLACK_PHOTOS_FEED_CHANNEL_ID=C0123456789

# Public app URL used in Slack message links. In production, set to https://photos.hackclub.com.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Required in production for distributed API rate limits.
REDIS_URL=redis://alice:foobared@awesome.redis.server:6380

# Separate ROC vision worker. Keep this endpoint private in production.
VISION_WORKER_URL=http://127.0.0.1:3100
VISION_WORKER_TOKEN=replace-with-at-least-32-random-characters
VISION_DATA_ENCRYPTION_KEY=replace-with-at-least-32-other-random-characters
# Used to encrypt reusable face templates at rest. Do not rotate without a migration.
FACE_DATA_ENCRYPTION_KEY=replace-with-at-least-32-separate-random-characters
RATE_LIMIT_FAIL_OPEN=false

# Optional Docker Compose overrides.
WEB_MEMORY_LIMIT=4g
VISION_MEMORY_LIMIT=8g
VISION_REDIS_URL=redis://vision-redis:6379

# APP_VERSION=<git-sha-or-release>
LOG_LEVEL=info
OTEL_SERVICE_NAME=hackclub-photos
