{
  "name": "hack-club-photos",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "packageManager": "bun@1.3.14",
  "scripts": {
    "dev": "next dev -H 0.0.0.0",
    "build": "next build",
    "start": "next start",
    "vercel:build": "node scripts/vercel-build.mjs",
    "lint": "biome check",
    "format": "biome format --write",
    "typecheck": "next typegen && tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node scripts/run-migrations.mjs",
    "db:studio": "drizzle-kit studio",
    "vision:dev": "npm --prefix services/vision-worker run dev",
    "vision:build": "npm --prefix services/vision-worker run build",
    "vision:start": "npm --prefix services/vision-worker run start"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1111.0",
    "@aws-sdk/s3-request-presigner": "^3.1111.0",
    "@flags-sdk/vercel": "^1.4.6",
    "@smithy/node-http-handler": "^4.11.3",
    "@trpc/client": "^11.18.0",
    "@trpc/server": "^11.18.0",
    "@vercel/analytics": "^2.0.1",
    "@vercel/functions": "^3.9.3",
    "@vercel/speed-insights": "^2.0.0",
    "archiver": "^8.0.0",
    "date-fns": "^4.4.0",
    "drizzle-orm": "^0.45.2",
    "exifr": "^7.1.3",
    "flags": "^4.3.0",
    "ioredis": "^6.0.0",
    "jose": "^6.2.9",
    "leaflet": "^1.9.4",
    "leaflet-defaulticon-compatibility": "^0.1.2",
    "mediainfo.js": "^0.3.7",
    "nanoid": "^6.0.1",
    "next": "^16.3.3",
    "papaparse": "^5.6.0",
    "pino": "^10.3.1",
    "postgres": "^3.4.9",
    "qrcode.react": "^4.2.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-dropzone": "^20.1.0",
    "react-icons": "^5.7.0",
    "react-leaflet": "^5.0.0",
    "recharts": "^3.10.1",
    "sharp": "^0.35.4",
    "supercluster": "^9.0.0",
    "superjson": "^2.2.6",
    "tailwind-merge": "^3.6.0",
    "use-debounce": "^10.1.1",
    "use-supercluster": "^1.2.0",
    "ws": "^8.21.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "2.2.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/archiver": "^8.0.0",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^26.2.0",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/yazl": "^3.3.1",
    "babel-plugin-react-compiler": "1.0.0",
    "drizzle-kit": "^0.31.10",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2"
  }
}
